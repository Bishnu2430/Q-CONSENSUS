# Normalize text files to LF in the repo and in the working tree, whatever
# core.autocrlf says. Shell scripts copied into Linux containers break with
# CRLF, so this is what keeps a Windows checkout working.
* text=auto eol=lf

# Windows-only launchers keep CRLF (cmd.exe misparses LF-only batch files).
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.ico binary
*.png binary
*.jpg binary
*.onnx binary
*.gguf binary
