# Core runtime
EVENT_STORE_DIR=data/events
ARTIFACT_STORE_DIR=data/artifacts
QC_BASE_SEED=42
AGENTS_CONFIG_PATH=config/agents.yaml

# Host ports published by Docker (and used by dev mode). If Windows reports one
# as reserved or in use, pick another here; scripts\start.cmd check tells you.
API_PORT=8000
LLM_PORT=8080
RPC_PORT=8545
VITE_PORT=5173

# LLM endpoint (llama.cpp server)
LLM_BASE_URL=http://llama:8080
LLM_API_KEY=
# The GGUF model is not stored in the repo: the "models" Docker service
# downloads it once into the qconsensus_models volume. LLAMA_MODEL_FILE is its
# name in that volume, so give it a new name when changing LLAMA_MODEL_URL.
# An empty LLAMA_MODEL_SHA256 skips checksum verification.
LLAMA_MODEL_FILE=Qwen2.5-3B-Instruct-Q4_K_M.gguf
LLAMA_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-3B-Instruct-GGUF/resolve/main/qwen2.5-3b-instruct-q4_k_m.gguf
LLAMA_MODEL_SHA256=626b4a6678b86442240e33df819e00132d3ba7dddfe1cdc4fbb18e0a9615c62d
# Per-reply token budget and request timeout. If the LLM server is unreachable
# a run fails with a clear error; MOCK_LLM=true swaps in canned replies
# (labelled "[MOCK LLM]") for offline UI testing only.
LLM_MAX_TOKENS=400
LLM_REQUEST_TIMEOUT_SECONDS=180
MOCK_LLM=false

# Contract-based blockchain anchoring. scripts\start.cmd fills the account with
# the local dev chain's well-known test account and deploys the contract
# (writing ANCHOR_CONTRACT_ADDRESS) when these are empty.
CONTRACT_ANCHOR_ENABLED=true
ETH_RPC_URL=http://blockchain:8545
ETH_CHAIN_ID=1337
ETH_FROM_ADDRESS=
ETH_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=

SERPAPI_KEY=

# API hardening (all optional; unset = today's fully-open local/dev behavior)
API_KEY=
CORS_ALLOW_ORIGINS=*
RUN_RATE_LIMIT_MAX=10
RUN_RATE_LIMIT_WINDOW_SECONDS=60

# Local text-to-speech (Piper). Off by default. With TTS_ENABLED=true the
# Docker "models" service downloads the voice into the models volume; for dev
# mode run  .venv\Scripts\python scripts\download_tts_voice.py  once instead.
TTS_ENABLED=false
TTS_VOICE_MODEL_PATH=models/tts/en_US-libritts_r-medium.onnx
