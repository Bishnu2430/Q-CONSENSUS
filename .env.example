# Core runtime
EVENT_STORE_DIR=data/events
ARTIFACT_STORE_DIR=data/artifacts
QC_BASE_SEED=42
AGENTS_CONFIG_PATH=config/agents.yaml

# Docker: the orchestrator container runs as a non-root user so files it
# writes into the bind-mounted ./data stay owned by a normal user on the
# host. Defaults to 1000:1000; override if that doesn't match your host
# user (check with `id -u`/`id -g`) to avoid permission errors on ./data.
APP_UID=1000
APP_GID=1000

# LLM endpoint (llama.cpp server)
LLM_BASE_URL=http://llama:8080
LLM_API_KEY=
LLAMA_MODEL_FILE=Qwen2.5-3B-Instruct-Q4_K_M.gguf
# Per-reply token budget and request timeout. If the LLM server is unreachable
# a run fails with a clear error; MOCK_LLM=true swaps in canned replies
# (labelled "[MOCK LLM]") for offline UI testing only.
LLM_MAX_TOKENS=400
LLM_REQUEST_TIMEOUT_SECONDS=180
MOCK_LLM=false

# Contract-based blockchain anchoring. scripts/start.sh fills the account with
# the local dev chain's well-known test account and deploys the contract
# (writing ANCHOR_CONTRACT_ADDRESS) when these are empty.
CONTRACT_ANCHOR_ENABLED=true
ETH_RPC_URL=http://blockchain:8545
ETH_CHAIN_ID=1337
ETH_FROM_ADDRESS=
ETH_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=

SERPAPI_KEY=

# API hardening (all optional; unset = today's fully-open local/dev behavior)
API_KEY=
CORS_ALLOW_ORIGINS=*
RUN_RATE_LIMIT_MAX=10
RUN_RATE_LIMIT_WINDOW_SECONDS=60

# Local text-to-speech (Piper). Off by default; run
# scripts/download_tts_voice.py once to fetch the voice model before enabling.
TTS_ENABLED=false
TTS_VOICE_MODEL_PATH=models/tts/en_US-libritts_r-medium.onnx
