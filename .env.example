# Optional settings. .env is not required: every value below is the default,
# so copy this file to .env only to change something.
#
# How the containers reach each other (LLM endpoint, blockchain RPC, dev-chain
# account, anchor contract address) is defined in docker-compose.yml and can't
# be overridden here. The contract is deployed by the "contract" service.

QC_BASE_SEED=42

# LLM behavior. If the LLM server is unreachable a run fails with a clear
# error; MOCK_LLM=true swaps in canned replies (labelled "[MOCK LLM]") for
# offline UI testing only.
LLM_MAX_TOKENS=400
LLM_REQUEST_TIMEOUT_SECONDS=180
MOCK_LLM=false

# Anchor each run's commitment on the local blockchain.
CONTRACT_ANCHOR_ENABLED=true

# Web search context for debates (optional).
SERPAPI_KEY=

# API hardening (all optional; unset = fully open local/dev behavior)
API_KEY=
CORS_ALLOW_ORIGINS=*
RUN_RATE_LIMIT_MAX=10
RUN_RATE_LIMIT_WINDOW_SECONDS=60

# Local text-to-speech (Piper). With TTS_ENABLED=true the Docker "models"
# service downloads the voice; for dev mode run
# .venv\Scripts\python scripts\download_tts_voice.py once instead.
TTS_ENABLED=false
TTS_VOICE_MODEL_PATH=models/tts/en_US-libritts_r-medium.onnx

# Model served by the llama container, downloaded once into the
# qconsensus_models Docker volume. Give LLAMA_MODEL_FILE a new name when
# changing the URL; an empty LLAMA_MODEL_SHA256 skips verification.
# LLAMA_MODEL_FILE=Qwen2.5-3B-Instruct-Q4_K_M.gguf
# LLAMA_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-3B-Instruct-GGUF/resolve/main/qwen2.5-3b-instruct-q4_k_m.gguf
# LLAMA_MODEL_SHA256=626b4a6678b86442240e33df819e00132d3ba7dddfe1cdc4fbb18e0a9615c62d

# Host ports. Change one if Windows reports it as reserved or in use
# (scripts\start.cmd check tells you).
# API_PORT=8000
# LLM_PORT=8080
# RPC_PORT=8545
# VITE_PORT=5173
